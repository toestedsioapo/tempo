{
  "name": "tempo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"@tempo/*\" build",
    "typecheck": "pnpm --filter \"@tempo/*\" typecheck",
    "lint": "eslint \"**/*.{ts,tsx}\" --cache",
    "test": "pnpm --filter \"@tempo/*\" test --passWithNoTests"
  }
}
