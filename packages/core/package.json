{
  "name": "@marvinliem/tempo-core",
  "version": "0.1.0",
  "description": "Deterministic meeting-time negotiation engine: does a slot fit everyone's working hours, and if not, ranked counter-offers with reasons.",
  "keywords": [
    "scheduling",
    "time-zones",
    "dst",
    "meeting",
    "availability",
    "working-hours"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Marvin Liemor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toestedsioapo/tempo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/toestedsioapo/tempo/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/toestedsioapo/tempo/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rules.schema.json": "./schema/rules.schema.json",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "schema",
    "fixtures"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsx scripts/copy-schema.ts && tsx scripts/copy-fixtures.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=json-summary",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "prepack": "tsx scripts/copy-schema.ts && tsx scripts/copy-fixtures.ts",
    "lock:fixtures": "tsx scripts/lock-fixtures.ts"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
