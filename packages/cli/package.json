{
  "name": "@marvinliem/tempo",
  "version": "0.1.0",
  "description": "Command-line interface for Tempo: check, suggest and explain meeting times across time zones, from JSON.",
  "keywords": [
    "scheduling",
    "time-zones",
    "dst",
    "meeting",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Marvin Liemor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toestedsioapo/tempo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/toestedsioapo/tempo/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/toestedsioapo/tempo/issues"
  },
  "bin": {
    "tempo": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@marvinliem/tempo-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
