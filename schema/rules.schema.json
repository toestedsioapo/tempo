{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "start": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "start",
        "end",
        "timeZone"
      ],
      "additionalProperties": false
    },
    "participants": {
      "minItems": 2,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "timeZone": {
            "type": "string"
          },
          "weeklyRules": {
            "type": "object",
            "properties": {
              "monday": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    "end": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                        },
                        {
                          "type": "string",
                          "const": "24:00"
                        }
                      ]
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              },
              "tuesday": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    "end": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                        },
                        {
                          "type": "string",
                          "const": "24:00"
                        }
                      ]
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              },
              "wednesday": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    "end": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                        },
                        {
                          "type": "string",
                          "const": "24:00"
                        }
                      ]
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              },
              "thursday": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    "end": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                        },
                        {
                          "type": "string",
                          "const": "24:00"
                        }
                      ]
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              },
              "friday": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    "end": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                        },
                        {
                          "type": "string",
                          "const": "24:00"
                        }
                      ]
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              },
              "saturday": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    "end": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                        },
                        {
                          "type": "string",
                          "const": "24:00"
                        }
                      ]
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              },
              "sunday": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    "end": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                        },
                        {
                          "type": "string",
                          "const": "24:00"
                        }
                      ]
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "blackouts": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "required": [
          "partyId",
          "timeZone",
          "weeklyRules"
        ],
        "additionalProperties": false
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "now": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
        },
        "minNoticeMinutes": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 525600
        },
        "searchHorizonDays": {
          "default": 14,
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "searchStepMinutes": {
          "default": 15,
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "maxSuggestions": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "now"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "request",
    "participants",
    "options"
  ],
  "additionalProperties": false,
  "title": "Tempo negotiation request"
}
